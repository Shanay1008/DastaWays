APP_NAME=DastaWays API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/dastaways.db
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=10
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DISTANCE_THRESHOLD=0.65
RAG_TOP_K=4
# Add an LLM provider key in a later phase. Never commit real credentials.
